# Default-deny agent contents: Pi writes private state beside its configuration.
# New reusable resources must be explicitly allowed below.
/agent/*
!/agent/AGENTS.md
!/agent/settings.json
!/agent/keybindings.json
!/agent/mcp.json

!/agent/extensions/
/agent/extensions/*
!/agent/extensions/pi-footer/
/agent/extensions/pi-footer/*
!/agent/extensions/pi-footer/index.ts
!/agent/extensions/pi-workflows-shortcut/
/agent/extensions/pi-workflows-shortcut/*
!/agent/extensions/pi-workflows-shortcut/index.ts
!/agent/extensions/pi-permission-system/
/agent/extensions/pi-permission-system/*
!/agent/extensions/pi-permission-system/config.json

!/agent/skills/
/agent/skills/*
!/agent/skills/eli10/
/agent/skills/eli10/*
!/agent/skills/eli10/SKILL.md
!/agent/skills/grill-me/
/agent/skills/grill-me/*
!/agent/skills/grill-me/SKILL.md

!/agent/themes/
/agent/themes/*
!/agent/themes/gruvbox-dark.json
!/agent/themes/gruvbox-light.json

!/agent/patches/
!/agent/review-lite/
/agent/review-lite/*
!/agent/review-lite/README.md
!/agent/review-lite/install.mjs
!/agent/review-lite/review-lite.ts
!/agent/review-lite/test/
/agent/review-lite/test/*
!/agent/review-lite/test/*.mjs

# Defense in depth, including backups of otherwise tracked configuration.
**/auth.json
**/mcp-auth.json
**/mcp-oauth/
**/sessions/
**/node_modules/
**/logs/
**/.rt-linkcache/
**/.git/
**/*.log
**/*.jsonl
**/*.bak
**/*.bak-*
**/*.prepatch.bak
**/*.tmp
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
